generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  games       Game[]
  connections GameConnection[]
  gameTags    Tag[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Game {
  id                   String    @id @default(cuid())
  name                 String
  platform             String
  lastPlayed           DateTime?
  userId               String
  iconUrl              String?
  imageFit             String    @default("auto")
  imagePosition        String    @default("center")
  hasPlatinum          Boolean   @default(false)
  isHidden             Boolean   @default(false)
  source               String    @default("manual")
  externalGameId       String?
  playtimeMinutes      Int?
  progress             Int?
  earnedAchievements   Int?
  totalAchievements    Int?
  lastAchievementName  String?
  lastAchievementAt    DateTime?
  achievementStatus    String    @default("pending")
  status               String    @default("completed")
  achievementsSyncedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags GameTag[]

  @@unique([userId, source, externalGameId])
  @@index([userId])
  @@index([userId, hasPlatinum, lastPlayed])
}

model Tag {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  color          String   @default("#3B82F6")
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  games GameTag[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

model GameTag {
  gameId String
  tagId  String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
}

model GameConnection {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  externalUserId String
  lastSyncedAt   DateTime?
  syncError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, externalUserId])
}
